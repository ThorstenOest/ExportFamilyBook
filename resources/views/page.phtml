use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\View;
// the help in the language of webtrees: page_help.<language>.html (e.g. page_help.de.html), else English
$help_language = explode('-', I18N::languageTag())[0];
$help_file = __DIR__ . '/page_help.' . $help_language . '.html';
$html_help_content = file_get_contents(preg_match('/^[a-z]+$/', $help_language) && is_file($help_file) ? $help_file : __DIR__ . '/page_help.html');
$escaped_help_content = json_encode($html_help_content, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);
?>
