<?php if ($valid) : ?>
<script>
(function () {
    'use strict';
    const I18N = <?= $json($i18n) ?>;
    const ROWS = <?= $json($rows) ?>;
    const PEOPLE = <?= $json((object) $people) ?>;
    const CAN_SAVE = <?= $can_save ? 'true' : 'false' ?>;
    const SEARCH_URL = <?= $json($search_url) ?>;
    const root = document.getElementById('efb-branches');
    const tbody = document.getElementById('efb-tbody');
    const form = document.getElementById('efb-form');
    const number = new Intl.NumberFormat(document.documentElement.lang || undefined);
    let rows = ROWS.map(function (row) { return Object.assign({}, row, {stops: (row.stops || []).slice()}); });
    let nextId = 1;
    let submitting = false;

    function el(tag, attrs, text) {
        const node = document.createElement(tag);
        Object.keys(attrs || {}).forEach(function (key) {
            if (key === 'className') {
                node.className = attrs[key];
            } else {
                node.setAttribute(key, attrs[key]);
            }
        });
        if (text !== undefined) {
            node.textContent = text;
        }
        return node;
    }

    function format(text, value) {
        return text.replace('%s', value);
    }

    // the data sent to the server: unchanged lines only by their ID
    function serialize() {
        return rows.map(function (row) {
            if (row.type !== 'branch') {
                return {id: row.id, type: row.type};
            }
            return {
                id: row.id, type: 'branch', xref: row.xref, name: row.name, direction: row.direction,
                stops: row.stops.slice(), h5: row.h5, h6: row.h6, include: row.include
            };
        });
    }
    const initial = JSON.stringify(serialize());

    function headingDefaults() {
        const h5 = document.getElementById('efb-default-h5');
        const h6 = document.getElementById('efb-default-h6');
        return {h5: h5 ? h5.value : '', h6: h6 ? h6.value : '', changed: (h5 && h5.value !== h5.defaultValue) || (h6 && h6.value !== h6.defaultValue)};
    }

    function isDirty() {
        return <?= $unsaved ? 'true' : 'false' ?> || JSON.stringify(serialize()) !== initial || headingDefaults().changed;
    }

    function updateStatus() {
        const branches = rows.filter(function (row) { return row.type === 'branch'; });
        const on = branches.filter(function (row) { return row.include; }).length;
        document.getElementById('efb-count').textContent = <?= $json(I18N::translate('%1$s of %2$s branches are exported.', '{on}', '{all}')) ?>
            .replace('{on}', number.format(on)).replace('{all}', number.format(branches.length));
        document.getElementById('efb-dirty').hidden = !isDirty();
        document.getElementById('efb-empty').hidden = branches.length > 0;
    }

    function personLink(xref) {
        const person = PEOPLE[xref];
        if (!person) {
            return el('span', {className: 'efb-person text-danger'}, format(I18N.unknown, xref));
        }
        if (person.url === '') {
            return el('span', {className: 'efb-person'}, person.label);
        }
        return el('a', {className: 'efb-person', href: person.url, target: '_blank', rel: 'noopener'}, person.label);
    }

    // search field of webtrees for individuals; calls onPick(xref) after a choice
    function picker(cell, onPick, onCancel) {
        const box = el('div', {className: 'efb-picker d-flex gap-1'});
        const select = el('select', {className: 'form-select form-select-sm tom-select', 'aria-label': I18N.select_individual});
        select.dataset.wtUrl = SEARCH_URL;
        select.dataset.wtI18nNoResults = I18N.no_results;
        select.appendChild(new Option('', ''));
        box.appendChild(select);
        if (onCancel) {
            const cancel = el('button', {type: 'button', className: 'btn btn-sm btn-link', title: I18N.cancel}, '×');
            cancel.addEventListener('click', onCancel);
            box.appendChild(cancel);
        }
        cell.appendChild(box);
        const tom = window.webtrees.initializeTomSelect(select);
        tom.on('change', function (value) {
            if (!value) {
                return;
            }
            // the text of the option is HTML of webtrees: read it as text only
            const html = (tom.options[value] && tom.options[value].text) || value;
            const label = new DOMParser().parseFromString(html, 'text/html').body.textContent.replace(/\s+/g, ' ').trim();
            if (!PEOPLE[value]) {
                PEOPLE[value] = {label: label, url: ''};
            }
            onPick(value);
        });
        tom.focus();
    }

    function iconButton(text, title, handler) {
        const button = el('button', {type: 'button', className: 'efb-icon', title: title, 'aria-label': title}, text);
        button.disabled = !CAN_SAVE;
        button.addEventListener('click', handler);
        return button;
    }

    function moveRow(index, delta) {
        const target = index + delta;
        if (target < 0 || target >= rows.length) {
            return;
        }
        const row = rows.splice(index, 1)[0];
        rows.splice(target, 0, row);
        render();
    }

    function messages(cell, row) {
        (row.errors || []).forEach(function (text) {
            cell.appendChild(el('div', {className: 'efb-msg text-danger'}, text));
        });
        (row.warnings || []).forEach(function (text) {
            cell.appendChild(el('div', {className: 'efb-msg text-warning-emphasis'}, text));
        });
    }

    function branchCells(tr, row) {
        // export
        const tdExport = el('td');
        const box = el('input', {type: 'checkbox', className: 'form-check-input', 'aria-label': I18N.export});
        box.checked = row.include;
        box.disabled = !CAN_SAVE;
        box.addEventListener('change', function () {
            row.include = box.checked;
            tr.classList.toggle('efb-off', !row.include);
            updateStatus();
        });
        tdExport.appendChild(box);
        tr.appendChild(tdExport);

        // start individual
        const tdStart = el('td', {className: 'efb-person-cell'});
        function showStart() {
            tdStart.textContent = '';
            if (row.xref === '' && CAN_SAVE) {
                picker(tdStart, function (xref) { row.xref = xref; showStart(); updateStatus(); }, null);
            } else {
                tdStart.appendChild(row.xref === '' ? el('span', {className: 'text-danger'}, I18N.start_missing) : personLink(row.xref));
                if (CAN_SAVE) {
                    const change = el('button', {type: 'button', className: 'btn btn-sm btn-link py-0'}, I18N.change);
                    change.addEventListener('click', function () {
                        change.remove();
                        picker(tdStart, function (xref) { row.xref = xref; showStart(); updateStatus(); }, showStart);
                    });
                    tdStart.appendChild(change);
                }
            }
            if (row.isNew) {
                tdStart.appendChild(el('span', {className: 'badge bg-info text-dark ms-1'}, I18N.new_row));
            }
            if (row.new) {
                tdStart.appendChild(el('span', {className: 'badge bg-info text-dark ms-1', title: I18N.not_in_set_title}, I18N.not_in_set));
            }
            messages(tdStart, row);
        }
        showStart();
        tr.appendChild(tdStart);

        // name
        const tdName = el('td');
        const name = el('input', {type: 'text', className: 'form-control form-control-sm efb-name', 'aria-label': I18N.name});
        name.value = row.name;
        name.disabled = !CAN_SAVE;
        name.addEventListener('input', function () { row.name = name.value; updateStatus(); });
        tdName.appendChild(name);
        tr.appendChild(tdName);

        // direction
        const tdDirection = el('td');
        const direction = el('select', {className: 'form-select form-select-sm efb-direction', 'aria-label': I18N.direction});
        Object.keys(I18N.directions).forEach(function (value) {
            direction.appendChild(new Option(I18N.directions[value], value, false, value === row.direction));
        });
        direction.disabled = !CAN_SAVE;
        direction.addEventListener('change', function () { row.direction = direction.value; updateStatus(); });
        tdDirection.appendChild(direction);
        tr.appendChild(tdDirection);

        // stop individuals
        const tdStops = el('td');
        function showStops() {
            tdStops.textContent = '';
            row.stops.forEach(function (xref, i) {
                const chip = el('span', {className: 'efb-chip'});
                chip.appendChild(personLink(xref));
                if (CAN_SAVE) {
                    chip.appendChild(iconButton('×', I18N.remove, function () {
                        row.stops.splice(i, 1);
                        showStops();
                        updateStatus();
                    }));
                }
                tdStops.appendChild(chip);
            });
            if (CAN_SAVE) {
                const add = el('button', {type: 'button', className: 'btn btn-sm btn-link py-0'}, '+ ' + I18N.add_stop);
                add.addEventListener('click', function () {
                    add.remove();
                    picker(tdStops, function (xref) {
                        if (row.stops.indexOf(xref) === -1) {
                            row.stops.push(xref);
                        }
                        showStops();
                        updateStatus();
                    }, showStops);
                });
                tdStops.appendChild(add);
            }
        }
        showStops();
        tr.appendChild(tdStops);

        // headings (book only)
        const tdHeadings = el('td', {className: 'efb-headings'});
        const defaults = headingDefaults();
        [['h5', I18N.heading_branch], ['h6', I18N.heading_generation]].forEach(function (pair) {
            const input = el('input', {type: 'text', className: 'form-control form-control-sm efb-heading', 'aria-label': pair[1], title: pair[1]});
            input.value = row[pair[0]];
            input.placeholder = defaults[pair[0]];
            input.dataset.key = pair[0];
            input.disabled = !CAN_SAVE;
            input.addEventListener('input', function () { row[pair[0]] = input.value; updateStatus(); });
            tdHeadings.appendChild(input);
        });
        tr.appendChild(tdHeadings);
    }

    function render() {
        tbody.textContent = '';
        rows.forEach(function (row, index) {
            const tr = el('tr');
            tr.dataset.index = String(index);
            tr.dataset.id = row.id;

            const tdHandle = el('td');
            const handle = el('span', {className: 'efb-handle', title: I18N.move}, '⋮⋮');
            if (CAN_SAVE) {
                handle.addEventListener('mousedown', function () { tr.draggable = true; });
                handle.addEventListener('mouseup', function () { tr.draggable = false; });
            }
            tdHandle.appendChild(handle);
            tr.appendChild(tdHandle);

            if (row.type === 'branch') {
                tr.classList.toggle('efb-off', !row.include);
                branchCells(tr, row);
            } else {
                tr.classList.add(row.type === 'blank' ? 'efb-blank' : 'efb-raw');
                const td = el('td', {colspan: '5'});
                if (row.type === 'blank') {
                    td.textContent = '— ' + I18N.empty_line + ' —';
                } else {
                    td.appendChild(el('div', {className: 'efb-line'}, row.line));
                    td.appendChild(el('div', {}, (I18N.reasons[row.reason] || '') + ' – ' + I18N.kept));
                }
                tr.appendChild(td);
                tr.appendChild(el('td', {className: 'efb-headings'}));
            }

            const tdActions = el('td', {className: 'text-nowrap'});
            tdActions.appendChild(iconButton('↑', I18N.up, function () { moveRow(index, -1); }));
            tdActions.appendChild(iconButton('↓', I18N.down, function () { moveRow(index, 1); }));
            tdActions.appendChild(iconButton('🗑', I18N.delete, function () {
                if (row.type === 'raw' && !window.confirm(I18N.delete_line)) {
                    return;
                }
                rows.splice(index, 1);
                render();
            }));
            tr.appendChild(tdActions);
            tbody.appendChild(tr);
        });
        updateStatus();
    }

    // drag and drop of rows (handle in the first column)
    let dragIndex = null;
    tbody.addEventListener('dragstart', function (event) {
        const tr = event.target.closest('tr');
        dragIndex = Number(tr.dataset.index);
        tr.classList.add('efb-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', tr.dataset.id);
    });
    tbody.addEventListener('dragover', function (event) {
        if (dragIndex === null) {
            return;
        }
        event.preventDefault();
        tbody.querySelectorAll('.efb-drop-before').forEach(function (tr) { tr.classList.remove('efb-drop-before'); });
        const tr = event.target.closest('tr');
        if (tr) {
            tr.classList.add('efb-drop-before');
        }
    });
    tbody.addEventListener('drop', function (event) {
        event.preventDefault();
        const tr = event.target.closest('tr');
        if (dragIndex === null || !tr) {
            return;
        }
        let target = Number(tr.dataset.index);
        const row = rows.splice(dragIndex, 1)[0];
        if (target > dragIndex) {
            target--;
        }
        rows.splice(target, 0, row);
        dragIndex = null;
        render();
    });
    tbody.addEventListener('dragend', function () {
        dragIndex = null;
        tbody.querySelectorAll('tr').forEach(function (tr) {
            tr.draggable = false;
            tr.classList.remove('efb-dragging', 'efb-drop-before');
        });
    });

    function setAll(include) {
        rows.forEach(function (row) {
            if (row.type === 'branch') {
                row.include = include;
            }
        });
        render();
    }
    document.getElementById('efb-all-on').addEventListener('click', function () { setAll(true); });
    document.getElementById('efb-all-off').addEventListener('click', function () { setAll(false); });
    document.getElementById('efb-add').addEventListener('click', function () {
        rows.push({id: 'n' + (nextId++), type: 'branch', xref: '', name: '', direction: 'descendants', stops: [], h5: '', h6: '', include: true, isNew: true});
        render();
        tbody.lastElementChild.scrollIntoView({block: 'center'});
    });

    const showHeadings = document.getElementById('efb-show-headings');
    if (showHeadings) {
        showHeadings.addEventListener('change', function () { root.classList.toggle('efb-no-headings', !showHeadings.checked); });
        root.classList.add('efb-no-headings');
        ['efb-default-h5', 'efb-default-h6'].forEach(function (id) {
            document.getElementById(id).addEventListener('input', function () {
                const defaults = headingDefaults();
                tbody.querySelectorAll('.efb-heading').forEach(function (input) { input.placeholder = defaults[input.dataset.key]; });
                updateStatus();
            });
        });
        // show the headings if a row has headings of its own or errors in them
        if (rows.some(function (row) { return row.type === 'branch' && (row.h5 !== '' || row.h6 !== ''); })) {
            showHeadings.checked = true;
            root.classList.remove('efb-no-headings');
        }
    }

    form.addEventListener('submit', function (event) {
        document.getElementById('efb-rows').value = JSON.stringify(serialize());
        submitting = true;
    });

    window.addEventListener('beforeunload', function (event) {
        if (!submitting && isDirty()) {
            event.preventDefault();
            event.returnValue = I18N.unsaved;
        }
    });

    // the search field needs the script of webtrees, which is loaded after this page content
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', render);
    } else {
        render();
    }
})();
</script>
<?php endif ?>
