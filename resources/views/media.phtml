<script>
(function () {
    'use strict';
    const root = document.getElementById('efb-media');
    const container = document.getElementById('efb-groups');
    const groups = Array.from(container.querySelectorAll('.efb-group'));
    const cards = Array.from(container.querySelectorAll('.efb-card'));
    const byXref = new Map();
    const excluded = new Set();
    cards.forEach(function (card) {
        const xref = card.dataset.xref;
        if (!byXref.has(xref)) {
            byXref.set(xref, []);
        }
        byXref.get(xref).push(card);
        if (card.dataset.state === 'exclude') {
            excluded.add(xref);
        }
    });
    const initial = new Set(excluded);
    const number = new Intl.NumberFormat(document.documentElement.lang || undefined);

    function dirtyCount() {
        let n = 0;
        byXref.forEach(function (list, xref) {
            if (excluded.has(xref) !== initial.has(xref)) {
                n++;
            }
        });
        return n;
    }

    function updateCounters() {
        document.getElementById('efb-excluded').textContent = number.format(excluded.size);
        const n = dirtyCount();
        document.getElementById('efb-dirty-count').textContent = number.format(n);
        document.getElementById('efb-dirty').hidden = (n === 0);
    }

    function setExcluded(xref, exclude) {
        if (exclude) {
            excluded.add(xref);
        } else {
            excluded.delete(xref);
        }
        byXref.get(xref).forEach(function (card) {
            card.classList.toggle('efb-excluded', exclude);
            const box = card.querySelector('.efb-check');
            if (box) {
                box.checked = !exclude;
            }
        });
        updateCounters();
        applyFilter();
    }

    function applyFilter() {
        const status = document.getElementById('efb-status').value;
        const query = document.getElementById('efb-search').value.trim().toLowerCase();
        const since = document.getElementById('efb-since').value;
        const onlyNew = document.getElementById('efb-new').checked;
        const shown = new Set();
        groups.forEach(function (group) {
            const groupMatch = query === '' || group.dataset.search.indexOf(query) !== -1;
            let visible = 0;
            group.querySelectorAll('.efb-card').forEach(function (card) {
                const xref = card.dataset.xref;
                const out = excluded.has(xref);
                let show = (status === 'all') || (status === 'in' && !out) || (status === 'out' && out);
                show = show && (groupMatch || card.dataset.search.indexOf(query) !== -1);
                show = show && (since === '' || (card.dataset.changed !== '' && card.dataset.changed >= since));
                show = show && (!onlyNew || card.dataset.new === '1');
                card.classList.toggle('efb-hidden', !show);
                if (show) {
                    visible++;
                    shown.add(xref);
                }
            });
            group.classList.toggle('efb-hidden', visible === 0);
        });
        document.getElementById('efb-shown').textContent = number.format(shown.size);
    }

    function applyOrder() {
        const order = document.getElementById('efb-order').value;
        const sorted = groups.slice().sort(function (a, b) {
            if (order === 'alpha') {
                const c = a.dataset.sort.localeCompare(b.dataset.sort, undefined, {sensitivity: 'base'});
                if (c !== 0) {
                    return c;
                }
            }
            return Number(a.dataset.book) - Number(b.dataset.book);
        });
        sorted.forEach(function (group) {
            container.appendChild(group);
        });
    }

    container.addEventListener('change', function (event) {
        const box = event.target;
        if (box.classList && box.classList.contains('efb-check')) {
            setExcluded(box.dataset.xref, !box.checked);
        }
    });

    let timer = null;
    document.getElementById('efb-search').addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(applyFilter, 200);
    });
    ['efb-status', 'efb-since', 'efb-new'].forEach(function (id) {
        document.getElementById(id).addEventListener('change', applyFilter);
    });
    document.getElementById('efb-order').addEventListener('change', applyOrder);

    let submitting = false;
    document.getElementById('efb-form').addEventListener('submit', function (event) {
        // "Mark as reviewed" does not save the ticks
        if (event.submitter && event.submitter.value === 'review_media' && dirtyCount() > 0
            && !window.confirm(<?= json_encode(I18N::translate('There are unsaved changes.'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>)) {
            event.preventDefault();
            return;
        }
        document.getElementById('efb-exclude').value = Array.from(excluded).join(',');
        submitting = true;
    });
    window.addEventListener('beforeunload', function (event) {
        if (!submitting && dirtyCount() > 0) {
            event.preventDefault();
            event.returnValue = <?= json_encode(I18N::translate('There are unsaved changes.'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
        }
    });
})();
</script>
